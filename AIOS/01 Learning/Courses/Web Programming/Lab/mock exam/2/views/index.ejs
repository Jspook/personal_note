<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panda Keepers</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 900px; margin: 24px auto; padding: 0 16px; }
        table { border-collapse: collapse; width: 100%; margin-top: 12px; }
        th, td { border: 1px solid #cbd5e1; padding: 8px 12px; text-align: left; }
        th { background: #f1f5f9; }
        .actions { display: flex; gap: 6px; }
        .actions form { margin: 0; }
    </style>
</head>
<body>
    <h1>Panda Keepers</h1>
    <form method="GET" action="/">
        <select name = "zoo">
            <option value = "">All zoos</option>
            <% zoos.forEach(function(z) { %>
                <option value = "<%= z %>" <%= z === zoo ? 'selected' : '' %>><%= z %></option>
            <% }); %>
        </select>
        <button type = "submit">Filter</button>
    </form>
    <p><a href="/add">+ Add keeper</a></p>
    <table>
        <tr><th>ID</th><th>Name</th><th>Zoo</th><th>Role</th><th>Salary</th><th></th></tr>
        <% keepers.forEach(function(k) { %>
            <tr>
                <td><%= k.id %></td>
                <td><%= k.name %></td>
                <td><%= k.zoo %></td>
                <td><%= k.role %></td>
                <td><%= k.salary %></td>
                <td class="actions">
                    <a href="/edit/<%= k.id %>">Edit</a>
                    <form method = "post" action="/delete/<%= k.id %>" onsubmit = "return confirm('Delete <%= k.name %>?')">
                        <button type = "submit">Delete</button>
                    </form>
                </td>
            </tr>
        <% }); %>
    </table>
    <p>Total salary: <%= total %></p>
</body>
</html>
