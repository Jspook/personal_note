<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><title>Add keeper</title>
<style>body{font-family:system-ui,sans-serif;max-width:480px;margin:24px auto;padding:0 16px}label{display:block;margin-top:12px}input{width:100%;padding:6px}.error{background:#fee2e2;color:#991b1b;padding:8px 12px;border-radius:6px}</style></head>
<body>
    <h1>Add keeper</h1>
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <form method = "POST" action = "/add">
        <label>Name <input type = "text" name = "name" value = "<%= form.name || '' %>"></label>
        <label>Zoo <input type = "text" name = "zoo" value = "<%= form.zoo || '' %>"></label>
        <label>Role <input type = "text" name = "role" value = "<%= form.role || '' %>"></label>
        <label>Salary <input type = "number" name = "salary" value = "<%= form.salary || '' %>" min="0" step="0.01"></label>
        <button type = "submit">Save</button>
    </form>
    <p><a href="/">Back</a></p>
</body>
</html>
