<%- include('partials/header')%>
<h1>Panda Gallery</h1>
<div class="filters">
    <a href="/">All</a>
    <a href = "/?species=Giant">Giant</a>
    <a href = "/?species=Red">Red</a>
</div>

<% if (error) { %>
    <div class="error"><%= error %></div>
<% } else if (pandas.length === 0) { %>
    <p>No pandas found</p>
<% } else { %>
    <div class="grid">
        <% pandas.forEach(function(p) {%>
            <div class = "card">
                <img src = "<%= p.image_url %>" alt="<%= p.name %>">
                <div class = "body">
                    <h3><%= p.name %></h3>
                    <span class = "badge <%= p.species === 'Red' ? 'red' : '' %>"><%= p.species %></span>
                    <span>Age: <%= p.age %></span>
                    <a href = '/panda/<%= p.id %>'>View</a>
                </div>
            </div>
        <% }); %>           
    </div>
<% } %>
<% if (stats) { %>
    <p>Total: <%= stats.total %> pandas · Average age: <%= stats.avgAge %></p>
<% } %>

<%- include('partials/footer')%>
