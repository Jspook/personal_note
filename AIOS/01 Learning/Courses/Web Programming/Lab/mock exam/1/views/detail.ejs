<%- include('partials/header')%>

<% if (!panda) { %>
    <h2>Panda not found</h2>
    <a href="/">Back to gallery</a>
<% } else { %>
    <img src = "<%= panda.image_url %>" alt="<%= panda.name %>">
                <div class = "body">
                    <h1><%= panda.name %></h1>
                    <span class = "badge <%= panda.species === 'Red' ? 'red' : '' %>"><%= panda.species %></span>
                    <span>Age: <%= panda.age %></span>
                    <p>Species: <%= panda.species %></p>
                    <p>Weight: <%= panda.weight_kg %> kg</p>
                    <p>Zoo: <%= panda.zoo %></p>
                    <p>Diet: <%= panda.diet %></p>
                    <p>Description: <%= panda.description %></p>
                    <a href="/">Back to gallery</a>
                </div>
<% } %>

<%- include('partials/footer')%>
