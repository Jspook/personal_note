<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Directory</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #f4f6f9;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --text-main: #1e293b;
            --text-sub: #64748b;
            --primary: #2563eb;
            --badge-bg: #eff6ff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Prompt', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            padding: 2.5rem 1rem;
            min-height: 100vh;
        }

        .container {
            max-width: 1280px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            margin-bottom: 3rem;
        }

        header h1 {
            font-size: 2.25rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 0.5rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background-color: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 1rem;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .avatar-container {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            overflow: hidden;
            background-color: #e2e8f0;
            margin-bottom: 1rem;
            border: 3px solid var(--primary);
        }

        .avatar-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .emp-id {
            display: inline-block;
            background-color: var(--badge-bg);
            color: var(--primary);
            font-size: 0.8rem;
            font-weight: 600;
            padding: 0.25rem 0.75rem;
            border-radius: 9999px;
            margin-bottom: 0.5rem;
        }

        .emp-name {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--text-main);
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>รายชื่อพนักงาน (Employee Directory)</h1>
        </header>

        <% if (employees && employees.length > 0) { %>
            <div class="grid">
                <% employees.forEach((emp) => { 
                    const id = emp.EmployeeID || '';
                    const fullName = `${emp.FirstName || ''} ${emp.LastName || ''}`.trim() || 'ไม่ระบุชื่อ';
                    const imgUrl = `http://webdev.it.kmitl.ac.th:4000/emp-images/${id}.png`;
                    const detail = `http://webdev.it.kmitl.ac.th:4000/employee/${id}`
                %>
                    <div class="card">
                        <div class="avatar-container">
                            <img src="<%= imgUrl %>" alt="<%= fullName %>">
                        </div>
                        <span class="emp-id"><%= id %></span>
                        <h2 class="emp-name"><%= fullName %></h2>
                        <a href= "<%= detail %>">detail</a>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
        <% } %>
    </div>

</body>
</html>