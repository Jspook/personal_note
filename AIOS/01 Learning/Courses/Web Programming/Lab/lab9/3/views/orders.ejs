<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ระบบติดตามคำสั่งซื้อ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h3>🛒 ระบบติดตามคำสั่งซื้อ</h3>
        <hr>

        <!-- Add Order Form -->
        <form method="POST" action="/add" class="row g-2 mb-4">
            <div class="col-auto">
                <input type="text" name="customer" class="form-control" placeholder="ชื่อลูกค้า" required>
            </div>
            <div class="col-auto">
                <input type="text" name="product" class="form-control" placeholder="รายการสินค้า" required>
            </div>
            <div class="col-auto">
                <input type="text" name="address" class="form-control" placeholder="ที่อยู่" required>
            </div>
            <div class="col-auto">
                <input type="text" name="phone" class="form-control" placeholder="เบอร์โทร" required>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success">เพิ่มคำสั่งซื้อ</button>
            </div>
        </form>

        <!-- Orders Table -->
        <h5>รายการคำสั่งซื้อ</h5>
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>ลูกค้า</th>
                    <th>สินค้า</th>
                    <th>สถานะ</th>
                    <th>เปลี่ยนสถานะ</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                <tr>
                    <td><%= order.id %></td>
                    <td><%= order.customer %></td>
                    <td><%= order.product %></td>
                    <td>
                        <% if (order.status === 'จัดส่งแล้ว') { %>
                            <span class="badge bg-success"><%= order.status %></span>
                        <% } else if (order.status === 'กำลังจัดส่ง') { %>
                            <span class="badge bg-warning text-dark"><%= order.status %></span>
                        <% } else { %>
                            <span class="badge bg-secondary"><%= order.status %></span>
                        <% } %>
                    </td>
                    <td>
                        <form method="POST" action="/update/<%= order.id %>" class="d-flex gap-2">
                            <select name="status" class="form-select form-select-sm" style="width: auto;">
                                <option value="รอดำเนินการ" <%= order.status === 'รอดำเนินการ' ? 'selected' : '' %>>รอดำเนินการ</option>
                                <option value="กำลังจัดส่ง" <%= order.status === 'กำลังจัดส่ง' ? 'selected' : '' %>>กำลังจัดส่ง</option>
                                <option value="จัดส่งแล้ว" <%= order.status === 'จัดส่งแล้ว' ? 'selected' : '' %>>จัดส่งแล้ว</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">อัปเดต</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
