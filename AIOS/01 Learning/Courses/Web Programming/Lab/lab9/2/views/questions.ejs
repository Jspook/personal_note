<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Kanit', sans-serif;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">Questions</h1>

        <% if (result) { %>
            <div class="alert alert-info">
                <strong>Score: <%= result.score %> / <%= result.total %></strong>
            </div>
        <% } %>

        <form method="POST" action="/submit">
            <% questions.forEach((q, index) => { %>
                <div class="mb-4">
                    <h5><%= index + 1 %>. <%= q.Stem %></h5>
                    <% const alts = ['A', 'B', 'C', 'D']; %>
                    <% alts.forEach(alt => { %>
                        <%
                            let labelClass = '';
                            if (result) {
                                if (alt === q.Correct) {
                                    labelClass = 'text-success fw-bold';
                                } else if (alt === q.userAnswer && !q.isCorrect) {
                                    labelClass = 'text-danger';
                                }
                            }
                        %>
                        <div class="form-check">
                            <input class="form-check-input" type="radio"
                                   name="q<%= q.QID %>" value="<%= alt %>"
                                   id="q<%= q.QID %>_<%= alt %>"
                                   <%= (result && q.userAnswer === alt) ? 'checked' : '' %>
                                   <%= result ? 'disabled' : '' %>>
                            <label class="form-check-label <%= labelClass %>" for="q<%= q.QID %>_<%= alt %>">
                                <%= q['Alt_' + alt] %>
                            </label>
                        </div>
                    <% }) %>
                </div>
            <% }) %>

            <% if (!result) { %>
                <button type="submit" class="btn btn-primary mb-5">Submit</button>
            <% } else { %>
                <a href="/" class="btn btn-secondary mb-5">Try Again</a>
            <% } %>
        </form>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
